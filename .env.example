# Copy to .env.local (git-ignored) and fill in to run live tests / the gateway.
# Modal can instead authenticate via ~/.modal.toml (leave these unset if so).

# Enable live provider SDKs in the gateway
OSR_MODAL_REAL=1
OSR_VERCEL_REAL=1

# Modal BYOK (or use ~/.modal.toml)
OSR_MODAL_TOKEN_ID=ak-xxxxxxxxxxxxxxxxxxxxxx
OSR_MODAL_TOKEN_SECRET=as-xxxxxxxxxxxxxxxxxxxxxx

# Vercel BYOK — all three are required for Vercel Sandbox
OSR_VERCEL_TOKEN=vcp_xxxxxxxxxxxxxxxxxxxxxx
OSR_VERCEL_TEAM_ID=team_xxxxxxxxxxxxxxxxxxxx
OSR_VERCEL_PROJECT_ID=prj_xxxxxxxxxxxxxxxxxxxx
